APP_NAME="Hello Alibaug"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://helloalibaug.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=helloalibaug
DB_USERNAME=your_db_user
DB_PASSWORD=your_strong_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_mailgun_smtp_login
MAIL_PASSWORD=your_mailgun_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@helloalibaug.com"
MAIL_FROM_NAME="Hello Alibaug"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap2

ADMIN_PREFIX=ha-control-2026

# Free tier: https://www.geoapify.com/ — used by `php artisan listings:geocode`
# to backfill listing lat/lng from their address.
GEOAPIFY_API_KEY=

# Shown on the Privacy Policy and Terms pages. Set the registered business
# name and a named grievance officer — Indian IT Act / DPDP rules expect a
# contactable person to be published.
LEGAL_ENTITY_NAME="Hello Alibaug"
LEGAL_GRIEVANCE_OFFICER=
LEGAL_CONTACT_EMAIL=hello@helloalibaug.com

# Free, no card required: https://dash.cloudflare.com/?to=/:account/turnstile
# Protects the inquiry, contact, registration and newsletter forms from bots.
# Leave both blank to disable — forms work normally with no CAPTCHA until set.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"
